# Force LF line endings for shell scripts (run inside Docker Linux containers)
*.sh text eol=lf

# Force LF for TypeScript/JavaScript (consistent cross-platform)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.sol text eol=lf

# PowerShell scripts can use CRLF (native Windows)
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
